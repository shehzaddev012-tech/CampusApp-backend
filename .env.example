# Copy to .env and fill in. .env is never committed.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# PostgreSQL. Local development example:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/campushub

# Secret that signs sign-in tokens. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars

# dev      = sign in with a test email (development only, refused in production)
# firebase = real Google sign-in (needs FIREBASE_SERVICE_ACCOUNT)
AUTH_MODE=dev

# Path to the Firebase service-account JSON. Enables Google sign-in and real push notifications.
# FIREBASE_SERVICE_ACCOUNT=./service-account.json

ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN=*
RUN_JOBS=true

# ── Email (verification codes, sign-in codes, password reset) ───────────────
# Leave SMTP_HOST empty in development: emails are kept in memory and the app can fill the code for you.
# Production REQUIRES these. Use the SMTP details of the mailbox/provider you send from.
#   Gmail:    SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false  SMTP_USER=you@gmail.com  SMTP_PASS=<16-char App Password>
#   Own domain / Zoho / Brevo / SendGrid etc.: use the host, port, user and password they give you.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# What people see as the sender, for example: CampusHub <no-reply@yourdomain.com>
MAIL_FROM=
# true = after the password, an emailed 6-digit code is required (two-step sign-in). Google sign-in is unaffected.
REQUIRE_LOGIN_OTP=true

# Where uploaded photos are kept (a folder on this server). Back it up. For several servers use an object store (see README).
UPLOADS_DIR=./uploads
